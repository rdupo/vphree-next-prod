# Copy to .env.local and fill in. Never commit real values.

# Browser-side Alchemy key (wallet/contract reads in the UI). Restrict it to your domains
# in the Alchemy dashboard, since anything NEXT_PUBLIC_ is visible to visitors.
NEXT_PUBLIC_API_KEY=

# Server-only Alchemy key used by the indexer and ENS lookups. Can be the same key as above,
# but a separate app/key keeps it private.
ALCHEMY_API_KEY=

# Neon Postgres connection string (Vercel -> Storage -> Neon, or neon.tech).
DATABASE_URL=

# Free key from https://etherscan.io/apis - used for the one-time backfill and large catch-ups.
ETHERSCAN_API_KEY=

# From the Alchemy Custom Webhook you create (see README "Indexer setup").
ALCHEMY_WEBHOOK_SIGNING_KEY=

# Any long random string. Vercel cron sends it as a Bearer token to /api/indexer/sync.
CRON_SECRET=

# Optional tuning
# SYNC_STALE_SECONDS=60          # how stale data can get before a page view triggers a catch-up
# ALCHEMY_MAX_BLOCK_RANGE=10     # raise if you upgrade off the Alchemy free tier
# MAX_ALCHEMY_CALLS_PER_SYNC=30
